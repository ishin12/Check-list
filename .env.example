# Demo mode: 1 = use the in-browser fake backend with seeded sample data so
# you can try every feature without setting anything up. Set to 0 once you
# have a real Supabase project configured below.
VITE_DEMO_MODE=1

# Real Supabase project (Settings → API). Required when VITE_DEMO_MODE=0.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets (set via `supabase secrets set ...`, NOT here):
#   RESEND_API_KEY=...
#   RESEND_FROM='Ghsoon Najd <noreply@your-domain.com>'
#   APP_URL=https://app.ghsoonnajd.com
#   WHATSAPP_TOKEN=...               # permanent token from Meta system user
#   WHATSAPP_PHONE_NUMBER_ID=...     # from WhatsApp Manager → API Setup
# (No WHATSAPP_TEMPLATE_NAMESPACE — Cloud API uses template name + language only.)
